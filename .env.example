MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<database>?retryWrites=true&w=majority
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_ORANGE=#EE7429
NEXT_PUBLIC_BRAND_GOLD=#FCCB11
ADMIN_ACCESS_CODE=YOUR_ADMIN_ACCESS_CODE_HERE
SESSION_SECRET=YOUR_32_CHARACTER_SESSION_SECRET_HERE

# Google OAuth ("Continue with Google") — create a Web application OAuth Client ID at
# https://console.cloud.google.com/apis/credentials and add these as authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback (dev)
#   https://<your-domain>/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# File Storage — Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
# Get this by running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (requires the Stripe CLI: brew install stripe/stripe-cli/stripe)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# Maintenance Mode (true to show maintenance page, false or remove to show main site)
MAINTENANCE_MODE=false

# Live chat (Zoho SalesIQ widget code — from your Zoho SalesIQ dashboard)
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=siq4815082d1f8d42f470da2630ed248fbae9fd9ca647b81e38200b3ebd25f3b49b

